// Section: Dash lifecycle — start / pause / resume / end, scheduling, idle & waiting-for-offer, the end-of-dash summary.
{
  "$schema": "../../../docs/rules.fragment.schema.json",
  "screens": [
    {
      "comment": "#733: the customer-NAME lines ('Pickup for <name>' / 'Deliver to <name>') normalize so their capture mask matches the parse surfaces' canonical-key hash; the STORE line ('Pickup from <store>') is a SEPARATE entry with NO normalize (canonicalizing a store name would corrupt its mask). Two entries, no overlap — a 'Pickup from' node never startsWith 'Pickup for'/'Deliver to'/'Return ' and vice-versa. #994 adds the FOURTH conjugation: a RETURN order renders the task line as 'Return <FirstName L> to <store>' (fielded 2026-08-01 12:53:16 / 13:06:36), which matched none of the three enumerated prefixes, so a customer's name shipped raw on this RECOGNIZED surface — the same shape as #962's 'Delivery to ' miss. Two notes on the entry. (a) The keepPrefix mask is WHOLE-remainder, so the trailing ' to <store>' is masked along with the name (screen redacts have no regex-capture form — `match`/`maskGroup` is notification-only). Accepted: the store is recoverable from this same frame's separate 'Pickup from <store>' line and from the offer/receipt parses, and a fail-toward-privacy over-mask beats enumerating a store tail. (b) The #623 mask↔hash invariant still HOLDS despite that tail, because `normalize: customerName` canonicalizes the stripped token to first-token + second-token-initial: customerNameKey('Nicole H to H-E-B') == customerNameKey('Nicole H') == 'nicole h', so the return line's 4hex equals the same customer's hex on every other surface. The rules-independent `CustomerTextMarkers` backstop is deliberately NOT extended with a 'Return ' entry — see that SSOT's deliberate-exclusions KDoc (DoorDash's own 'Return to dash' chrome button on on_dash_map makes the bare prefix chrome-ambiguous); this rule redact is the primary control, per the #806 doctrine.",
      "id": "doordash.screen.timeline",
      "priority": 10,
      "redact": [
        {
          "find": {
            "any": [
              {
                "hasTextStartsWith": "Pickup for "
              },
              {
                "hasTextStartsWith": "Deliver to "
              },
              {
                "hasTextStartsWith": "Return "
              }
            ]
          },
          "keepPrefix": [
            "Pickup for ",
            "Deliver to ",
            "Return "
          ],
          "normalize": "customerName"
        },
        {
          "find": {
            "hasTextStartsWith": "Pickup from "
          },
          "keepPrefix": [
            "Pickup from "
          ]
        },
        {
          "comment": "Combined-frame belt: the order-detail sheet (timeline_task_detail) can inflate over the timeline, which wins on priority — same entry as that rule; inert when the sheet is absent (pure shape predicate).",
          "find": {
            "all": [
              {
                "hasTextMatchesRegex": "^\\d{1,5}\\s+\\S"
              },
              {
                "hasNoId": true
              }
            ]
          }
        },
        {
          "comment": "Combined-frame belt: the order-detail sheet (timeline_task_detail) can inflate over the timeline, which wins on priority — same entry as that rule; inert when the sheet is absent (pure shape predicate).",
          "find": {
            "hasFollowingSiblingTextMatchesRegex": "[,\\s]{1,4}(?:[A-Za-z]{2},?\\s{1,4})?\\d{5}"
          }
        },
        {
          "comment": "Combined-frame belt: the order-detail sheet (timeline_task_detail) can inflate over the timeline, which wins on priority — same entry as that rule; inert when the sheet is absent (pure shape predicate).",
          "find": {
            "all": [
              {
                "hasTextMatchesRegex": "\\d{5}"
              },
              {
                "hasNoId": true
              }
            ]
          },
          "plainMask": true
        },
        {
          "comment": "Combined-frame belt: the order-detail sheet (timeline_task_detail) can inflate over the timeline, which wins on priority — same entry as that rule; inert when the sheet is absent (pure shape predicate).",
          "find": {
            "hasTextStartsWith": "\""
          },
          "plainMask": true
        },
        {
          "comment": "Combined-frame belt: the order-detail sheet (timeline_task_detail) can inflate over the timeline, which wins on priority — same entry as that rule; inert when the sheet is absent (pure shape predicate).",
          "find": {
            "all": [
              {
                "hasTextMatchesRegex": "^#?\\s?\\d{1,4}[A-Za-z]?$"
              },
              {
                "hasNoId": true
              }
            ]
          },
          "plainMask": true
        }
      ],
      "state": {
        "modeHint": "online"
      },
      "require": {
        "any": [
          {
            "allTextContainsAll": [
              "dash ends at",
              "pause orders"
            ]
          },
          {
            "allTextContainsAll": [
              "current dash",
              "current task"
            ]
          }
        ]
      },
      "parse": {
        "as": "timeline",
        "fields": {
          "sessionEarnings": {
            "textAfterLabel": "This dash",
            "offset": 1,
            "transform": "parseCurrency"
          },
          "offerEarnings": {
            "textAfterLabel": "This offer",
            "offset": 1,
            "transform": "parseCurrency"
          },
          "endsAtText": {
            "find": {
              "hasTextStartsWith": "Dash ends at"
            },
            "read": "text",
            "transform": {
              "stripPrefix": "Dash ends at "
            }
          },
          "endsAtMillis": {
            "find": {
              "hasTextStartsWith": "Dash ends at"
            },
            "read": "text",
            "transform": "parseDeadline"
          },
          "tasks": {
            "each": {
              "any": [
                {
                  "hasTextStartsWith": "Pickup for "
                },
                {
                  "hasTextStartsWith": "Deliver to "
                },
                {
                  "hasTextStartsWith": "Pickup from "
                }
              ]
            },
            "extract": {
              "taskType": {
                "conditionalEnum": [
                  {
                    "if": {
                      "exists": {
                        "hasTextStartsWith": "Deliver to "
                      }
                    },
                    "then": "Deliver to"
                  },
                  {
                    "if": {
                      "exists": {
                        "hasTextStartsWith": "Pickup from "
                      }
                    },
                    "then": "Pickup from"
                  },
                  {
                    "else": "Pickup for"
                  }
                ]
              },
              "nameHash": {
                "find": {
                  "any": [
                    {
                      "hasTextStartsWith": "Pickup for "
                    },
                    {
                      "hasTextStartsWith": "Deliver to "
                    },
                    {
                      "hasTextStartsWith": "Pickup from "
                    }
                  ]
                },
                "read": "text",
                "transform": [
                  {
                    "stripPrefixes": [
                      "Pickup for ",
                      "Deliver to ",
                      "Pickup from "
                    ]
                  },
                  "trim",
                  "sha256"
                ]
              },
              "deadlineText": {
                "find": {
                  "any": [
                    {
                      "hasTextStartsWith": "Pickup for "
                    },
                    {
                      "hasTextStartsWith": "Deliver to "
                    },
                    {
                      "hasTextStartsWith": "Pickup from "
                    }
                  ]
                },
                "navigate": "sibling(1)",
                "read": "text",
                "transform": {
                  "extractBefore": " • "
                }
              },
              "deadlineMillis": {
                "find": {
                  "any": [
                    {
                      "hasTextStartsWith": "Pickup for "
                    },
                    {
                      "hasTextStartsWith": "Deliver to "
                    },
                    {
                      "hasTextStartsWith": "Pickup from "
                    }
                  ]
                },
                "navigate": "sibling(1)",
                "read": "text",
                "transform": [
                  {
                    "extractBefore": " • "
                  },
                  "parseDeadline"
                ]
              },
              "storeHint": {
                "find": {
                  "any": [
                    {
                      "hasTextStartsWith": "Pickup for "
                    },
                    {
                      "hasTextStartsWith": "Deliver to "
                    },
                    {
                      "hasTextStartsWith": "Pickup from "
                    }
                  ]
                },
                "navigate": "sibling(1)",
                "read": "text",
                "transform": {
                  "extractAfter": " • "
                }
              },
              "isCurrent": {
                "presence": {
                  "exists": {
                    "hasTextContaining": "Current task"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "comment": "#985 (P1 Pledge, the standing top item) — the **Timeline order-detail bottom sheet**, opened by tapping a task row on `doordash.screen.timeline`. It is the documented #806 residual, fielded WITH a gate-access note: `<street>, Apt <n>` · `<City>, <ST> <zip>` · the dropoff option · a customer free-text note naming the building and asking the dasher to call to open the gate · a bare entry code, all reaching disk verbatim on the UNKNOWN path (2026-07-30 19:40:07, and the same shape across the 07-08 / 07-21 / 07-23 / 07-28 pulls — 58 envelopes carrying 'Copy address' in total, every one of them UNKNOWN). **Why every existing layer missed it:** the sibling task line WAS scrubbed (the #806 `CustomerTextMarkers` prefix scan fired on 'Deliver to '), but the address block is id-LESS **and** marker-LESS, so neither the prefix scan nor #910's `ID_MARKERS` can structurally reach it. Per the #806 doctrine the primary control for that class is a recognizing rule + `redact`, which is this. WHY THIS FILE: the sheet is the timeline's own drill-down and is TASK-PHASE AGNOSTIC — a dropoff row renders the customer's address, a pickup row renders the merchant's — so it has no dropoff-phase owner; `dropoff.json5` additionally holds a structural invariant (`DropoffBannerRedactParityTest`: every rule there declares the `arriving_at_title` belt) that this sheet, which never renders a nav banner, would have to satisfy with an inert entry. ANCHORS ARE CHROME, NEVER THE CUSTOMER: 'Copy address' (text) AND 'Close sheet' (contentDescription), required together. 'Copy address' appears on ZERO other surfaces across the committed corpus and all 2026 pulls, and 'Close sheet' is DoorDash's generic sheet dismiss — the pair is what keeps this off the other bottom sheets that share it (the 'Excluded orders' explainer, the on-time adjustment sheet, the dash-readiness sheet, the far-away completion sheet). Under-match is deliberate and safe: a half-inflated render that has not painted 'Copy address' yet stays UNKNOWN (still covered by the UNKNOWN-path scrubs). RECOGNIZE-ONLY: no `state.flow`, no `parse`. The sheet is a retrospective detail view, not a lifecycle edge — the task lifecycle is owned by the pickup/dropoff surfaces — so giving it a flow would be a state-machine change riding on a privacy fix. Per #995's correction, recognize-only is NOT state-INERT: these frames now reach the state machine at all and move `FrameGate.lastIdentity`. What no `state` block buys is NEUTRALITY (no flow, no modeHint, no events, no mode asserted from absence), which `FlowlessRecognitionNeutralityTest` asserts end-to-end over the committed fixtures rather than leaving to this comment. Priority 142 is the first free value across all doordash rules and is behaviorally inert (no other rule matches these trees today — they classified UNKNOWN).",
      "id": "doordash.screen.timeline_task_detail",
      "priority": 142,
      "redact": [
        {
          "comment": "The task line. Byte-identical prefix enumeration to `doordash.screen.timeline`'s own name entry (this sheet renders the SAME task vocabulary the row it opened from does, including #994's fourth 'Return <name> to <store>' conjugation), and `normalize: customerName` keeps the mask hex equal to the customer's persisted `customerNameHash` — one customer, one 4hex, on the timeline row and in its detail sheet alike (#623/#733). Ordered FIRST: 'Deliver to Avery K' also satisfies the id-less first-last-initial name shape, and this entry is the one that keeps the lead-in so a replayed envelope still reads as a task line. Note the device already scrubs this node to a plain '[redacted]' on the UNKNOWN path via the `CustomerTextMarkers` prefix backstop; that backstop keeps running on the recognized path too, so this entry is what upgrades the mask to the per-customer distinctness form rather than what first covers it.",
          "find": {
            "any": [
              {
                "hasTextStartsWith": "Pickup for "
              },
              {
                "hasTextStartsWith": "Deliver to "
              },
              {
                "hasTextStartsWith": "Return "
              }
            ]
          },
          "keepPrefix": [
            "Pickup for ",
            "Deliver to ",
            "Return "
          ],
          "normalize": "customerName"
        },
        {
          "comment": "Address line 1, digit-leading form — the fielded shape (e.g. '4120 Sample Hollow Dr, Apt 12' / '8900 Sample Forest' — invented equivalents of the two fielded renders). Same predicate as the `dropoff_pre_arrival` / `dropoff_handoff` family (Principle 5: this surface's address block is the same id-less two-line block those rules carry, so it gets the same entry set rather than a new dialect). Hash-mask, un-normalized: the token is a street line, not a customer NAME, and the name canonicalizer would collapse it to first-token + second-initial and destroy the mask's distinctness. **This deliberately also masks a MERCHANT address** on the pickup-task render of the same sheet (e.g. '10500 Sample Loop, San Antonio' under the store row — invented equivalent): line 1 sits in the identical slot for both task phases and nothing in the tree separates them, so — unlike `pickup_navigation`, which is unambiguously a merchant surface and is left raw by design (#886) — the only sound choice is to fail toward privacy. The store NAME is untouched, which is what triage and analytics actually read.",
          "find": {
            "all": [
              {
                "hasTextMatchesRegex": "^\\d{1,5}\\s+\\S"
              },
              {
                "hasNoId": true
              }
            ]
          }
        },
        {
          "comment": "Address line 1, VENUE form (#886's mirror predicate) — when the destination is an apartment complex or business, line 1 is a proper-noun name with no id, no digits and no stable shape ('Sample Ridge Apartments', fielded 07-23), and it is child 0 of its block so there is no preceding sibling to anchor on. The handle is its FOLLOWING sibling, the city/ST/ZIP line. The pattern is a deliberate SUPERSET of the `dropoff_pre_arrival` copy (`[,\\s][A-Za-z]{2},?\\s{1,4}\\d{5}`): this sheet fielded a STATE-LESS city render ('San Antonio,  78200', 07-23) that the two-letter-state requirement structurally misses, so the state group is optional here and the separator class is repeated. It is not written as a shared SSOT string precisely because it is not the same string — widening the other copies is a separate, corpus-gated change, and a privacy entry must never be loosened to match a sibling. Over-match surface is 'the node directly above a line containing <comma-or-space> [+ ST] + 5 digits', which on this sheet is only the address block's line 1 — the store row's following sibling is its street line (whose ZIP-less form matches nothing) and every chrome node's next sibling is a text-less Button. CAVEAT: this ZIP-less claim is fixture-specific — a pickup render whose store address line carries city/ST/ZIP will make the store NAME node match this entry and hash-mask. Over-mask, fail-toward-privacy, accepted; the store name is NOT guaranteed raw on this surface.",
          "find": {
            "hasFollowingSiblingTextMatchesRegex": "[,\\s]{1,4}(?:[A-Za-z]{2},?\\s{1,4})?\\d{5}"
          }
        },
        {
          "comment": "#889 F1 posture: the city/ST/ZIP line and any bare 5-digit code, plainMask. 10^5 values against 65 536 4-hex buckets is ~1.5 candidates per bucket — effectively recoverable — and the distinctness would be redundant anyway, since this surface's task-line and street entries already carry per-customer distinct masks. Ordered AFTER the two line-1 entries so a 5-digit house number (e.g. '21000 U.S. Highway 90 North, San Antonio' — invented equivalent of the fielded 5-digit-house-number render) is claimed by the street entry and keeps its hash.",
          "find": {
            "all": [
              {
                "hasTextMatchesRegex": "\\d{5}"
              },
              {
                "hasNoId": true
              }
            ]
          },
          "plainMask": true
        },
        {
          "comment": "The customer's free-text note, which DoorDash renders on this sheet wrapped in literal double quotes (shape: '\"please call so I can open the gate, building N on floor N\"' — invented equivalent of the fielded 07-30 note; the 07-23 render carried a gate code inside it). Customer-AUTHORED text, the #803/#920 class: it can carry a gate code, a unit, a name, a floor. `plainMask` follows #920's reasoning rather than the older un-plained quote entry on `dropoff_pre_arrival`: a note's ALPHABET is unbounded but its LENGTH is not, so a short note that IS the secret ('Gate 4417') clears the #889 floor while its plaintext space stays far below the suffix's 65 536 buckets — and unlike a customer name a note is nobody's join key, so the distinctness buys nothing to trade against that. Strictly stronger than the sibling entry it diverges from; a privacy entry may be tightened without waiting for the family.",
          "find": {
            "hasTextStartsWith": "\""
          },
          "plainMask": true
        },
        {
          "comment": "The bare entry/gate code rendered as its own node (3-digit codes, fielded; e.g. '641' — invented). Same shape and same `plainMask` argument as the `dropoff_pre_arrival` family: a bounded ~10^4 numeric alphabet, above the #889 length floor at 4 digits, so the 4-hex suffix would be an inversion oracle. The floor bounds LENGTH, this declaration bounds ALPHABET; they compose. Accepted over-mask: a merchant whose name IS a bare number (DoorDash test data fielded a store row reading '195') plains too — capture-only, and the store's own name row survives on every real render.",
          "find": {
            "all": [
              {
                "hasTextMatchesRegex": "^#?\\s?\\d{1,4}[A-Za-z]?$"
              },
              {
                "hasNoId": true
              }
            ]
          },
          "plainMask": true
        }
      ],
      "require": {
        "all": [
          {
            "exists": {
              "hasText": "Copy address"
            }
          },
          {
            "exists": {
              "hasDesc": "Close sheet"
            }
          }
        ]
      }
    },
    {
      "id": "doordash.screen.app_startup",
      "priority": 40,
      "require": {
        "all": [
          {
            "exists": {
              "hasIdSuffix": "progress_message"
            }
          },
          {
            "exists": {
              "any": [
                {
                  "hasIdSuffix": "image_logo"
                },
                {
                  "hasIdSuffix": "cancel_button"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "id": "doordash.screen.dash_paused",
      "priority": 50,
      "state": {
        "modeHint": "paused"
      },
      "require": {
        "all": [
          {
            "exists": {
              "hasText": "Dash Paused"
            }
          },
          {
            "exists": {
              "all": [
                {
                  "hasIdSuffix": "resumeButton"
                },
                {
                  "hasDesc": "Resume dash"
                }
              ]
            }
          },
          {
            "exists": {
              "hasIdSuffix": "progress_number"
            }
          }
        ]
      },
      "parse": {
        "as": "paused",
        "fields": {
          "remainingText": {
            "find": {
              "hasIdSuffix": "progress_number"
            },
            "read": "text",
            "fallback": "35:00"
          },
          "remainingMillis": {
            "find": {
              "hasIdSuffix": "progress_number"
            },
            "read": "text",
            "transform": "parseDuration",
            "fallback": 2100000
          }
        }
      }
    },
    {
      "id": "doordash.screen.end_dash_confirm",
      "priority": 52,
      "require": {
        "all": [
          {
            "exists": {
              "hasIdSuffix": "prism_sheet"
            }
          },
          {
            "exists": {
              "hasTextContaining": "End your current dash"
            }
          }
        ]
      }
    },
    {
      "id": "doordash.screen.schedule",
      "priority": 80,
      "require": {
        "all": [
          {
            "exists": {
              "all": [
                {
                  "hasText": "Schedule"
                },
                {
                  "hasClassName": "android.widget.TextView"
                }
              ]
            }
          },
          {
            "any": [
              {
                "exists": {
                  "hasText": "Available"
                }
              },
              {
                "exists": {
                  "hasText": "Scheduled"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "doordash.screen.dash_time_picker",
      "priority": 81,
      "require": {
        "allTextContainsAny": [
          "choose start time",
          "choose end time"
        ]
      }
    },
    {
      "id": "doordash.screen.dash_schedule",
      "priority": 82,
      "require": {
        "allTextContainsAny": [
          "schedule your dash for later",
          "this zone's full right now",
          "you scheduled a dash"
        ]
      }
    },
    {
      "id": "doordash.screen.dash_schedule_picker",
      "priority": 85,
      "require": {
        "all": [
          {
            "exists": {
              "hasText": "Start time"
            }
          },
          {
            "exists": {
              "hasText": "End Time"
            }
          },
          {
            "exists": {
              "hasText": "Schedule"
            }
          }
        ]
      }
    },
    {
      "id": "doordash.screen.on_dash_map",
      "priority": 110,
      "state": {
        "modeHint": "online"
      },
      "reject": [
        {
          "exists": {
            "hasDesc": "Earnings Mode Switcher"
          }
        },
        {
          "exists": {
            "any": [
              {
                "hasTextContaining": "looking for offers"
              },
              {
                "hasTextContaining": "finding offers"
              }
            ]
          }
        }
      ],
      "require": {
        "exists": {
          "hasText": "Return to dash"
        }
      }
    },
    {
      "id": "doordash.screen.dash_along_the_way",
      "priority": 111,
      "state": {
        "flow": "idle",
        "modeHint": "online"
      },
      "comment": "Repositioning-to-zone while online (idle, no offer yet). The id form is the bottom-sheet variant; the text form (#462) is the full-screen 'Navigate to zone / We'll look for orders along the way / Spot saved until …' card, which ships no viewIds.",
      "require": {
        "any": [
          {
            "all": [
              {
                "exists": {
                  "hasIdSuffix": "navigate_button"
                }
              },
              {
                "any": [
                  {
                    "exists": {
                      "hasIdSuffix": "bottom_view_info_ctd_v2_title"
                    }
                  },
                  {
                    "exists": {
                      "hasIdSuffix": "bottom_view_info_title"
                    }
                  }
                ]
              }
            ]
          },
          {
            "all": [
              {
                "exists": {
                  "hasTextContaining": "We'll look for orders along the way"
                }
              },
              {
                "exists": {
                  "any": [
                    {
                      "hasTextContaining": "Navigate to zone"
                    },
                    {
                      "hasTextContaining": "Spot saved until"
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "parse": {
        "as": "idle",
        "fields": {
          "isHeadingBackToZone": {
            "literal": false
          },
          "spotSaveDeadline": {
            "coalesce": [
              {
                "find": {
                  "all": [
                    {
                      "any": [
                        {
                          "hasIdSuffix": "bottom_view_info_ctd_v2_title"
                        },
                        {
                          "hasIdSuffix": "bottom_view_info_title"
                        }
                      ]
                    },
                    {
                      "hasTextContaining": "Spot saved until"
                    }
                  ]
                },
                "read": "text",
                "transform": "parseDeadline"
              },
              {
                "find": {
                  "hasTextContaining": "Spot saved until"
                },
                "read": "text",
                "transform": "parseDeadline"
              }
            ]
          }
        }
      }
    },
    {
      "id": "doordash.screen.waiting_for_offer",
      "priority": 120,
      "redact": [
        {
          "find": {
            "hasIdSuffix": "user_name"
          }
        },
        {
          "find": {
            "hasIdSuffix": "address_line_1"
          }
        },
        {
          "find": {
            "hasIdSuffix": "address_line_2"
          }
        }
      ],
      "state": {
        "flow": "idle",
        "modeHint": "online"
      },
      "reject": [
        {
          "exists": {
            "hasDesc": "Earnings Mode Switcher"
          }
        },
        {
          "exists": {
            "hasText": "Return to dash"
          }
        },
        {
          "exists": {
            "hasTextContaining": "look for orders along the way"
          }
        }
      ],
      "require": {
        "any": [
          {
            "exists": {
              "hasIdSuffix": "looking_for_order_progress_bar"
            }
          },
          {
            "exists": {
              "hasText": "Looking for offers"
            }
          },
          {
            "all": [
              {
                "exists": {
                  "hasTextContaining": "Finding offers"
                }
              },
              {
                "any": [
                  {
                    "exists": {
                      "hasTextContaining": "Zone offer wait"
                    }
                  },
                  {
                    "exists": {
                      "hasIdSuffix": "running_total_pay"
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "parse": {
        "as": "idle",
        "fields": {
          "sessionPay": {
            "find": {
              "hasIdSuffix": "running_total_pay"
            },
            "read": "text",
            "transform": "parseCurrency"
          },
          "waitTimeEstimate": {
            "coalesce": [
              {
                "find": {
                  "hasTextContaining": "Zone offer wait"
                },
                "navigate": "sibling(1)",
                "read": "text"
              },
              {
                "find": {
                  "hasIdSuffix": "wait_time_button"
                },
                "navigate": "findDescendant(textView_prism_button_title)",
                "read": "text",
                "transform": {
                  "stripPrefix": "est. "
                }
              }
            ]
          },
          "isHeadingBackToZone": {
            "presence": {
              "exists": {
                "hasIdSuffix": "cross_sp_title"
              }
            }
          }
        }
      }
    },
    {
      "id": "doordash.screen.account_checkup",
      "priority": 121,
      "require": {
        "all": [
          {
            "exists": {
              "hasTextContaining": "You're all set to receive offers"
            }
          },
          {
            "exists": {
              "hasTextContaining": "No account issues"
            }
          }
        ]
      }
    },
    {
      "id": "doordash.screen.set_dash_end_time",
      "priority": 130,
      "state": {
        "flow": "idle",
        "modeHint": "offline"
      },
      "require": {
        "all": [
          {
            "exists": {
              "hasIdSuffix": "starting_point_name"
            }
          },
          {
            "any": [
              {
                "exists": {
                  "hasTextContaining": "Select end time"
                }
              },
              {
                "exists": {
                  "hasIdSuffix": "end_time_description"
                }
              }
            ]
          }
        ]
      },
      "parse": {
        "as": "idle",
        "fields": {
          "zoneName": {
            "find": {
              "hasIdSuffix": "starting_point_name"
            },
            "read": "text"
          },
          "startingSession": {
            "literal": true
          }
        }
      }
    },
    {
      "id": "doordash.screen.idle_scheduled_dash_ready",
      "priority": 135,
      "state": {
        "flow": "idle",
        "modeHint": "offline"
      },
      "require": {
        "all": [
          {
            "exists": {
              "hasTextContaining": "Start your scheduled dash"
            }
          }
        ]
      },
      "parse": {
        "as": "idle",
        "fields": {
          "startingSession": {
            "literal": true
          }
        }
      }
    },
    {
      "id": "doordash.screen.idle_map",
      "priority": 140,
      "state": {
        "flow": "idle",
        "modeHint": "offline"
      },
      "reject": [
        {
          "exists": {
            "hasText": "Return to dash"
          }
        },
        {
          "exists": {
            "any": [
              {
                "hasTextContaining": "looking for offers"
              },
              {
                "hasTextContaining": "finding offers"
              }
            ]
          }
        }
      ],
      "require": {
        "all": [
          {
            "exists": {
              "hasDesc": "Earnings Mode Switcher"
            }
          },
          {
            "exists": {
              "any": [
                {
                  "hasIdSuffix": "side_nav_compose_view"
                },
                {
                  "hasDesc": "Side Menu"
                }
              ]
            }
          }
        ]
      },
      "parse": {
        "as": "idle",
        "fields": {
          "sessionType": {
            "conditionalEnum": [
              {
                "if": {
                  "exists": {
                    "hasDescContaining": "Time mode off"
                  }
                },
                "then": "PerOffer"
              },
              {
                "if": {
                  "exists": {
                    "hasDescContaining": "Time mode on"
                  }
                },
                "then": "ByTime"
              }
            ]
          }
        }
      }
    },
    {
      "id": "doordash.screen.dash_summary",
      "priority": 150,
      "state": {
        "flow": "session:ended",
        "modeHint": "offline"
      },
      "require": {
        "all": [
          {
            "exists": {
              "hasText": "Dash summary"
            }
          },
          {
            "exists": {
              "all": [
                {
                  "hasIdSuffix": "textView_prism_button_title"
                },
                {
                  "hasText": "Done"
                }
              ]
            }
          }
        ]
      },
      "parse": {
        "as": "session_ended",
        "fields": {
          "totalEarnings": {
            "coalesce": [
              {
                "find": {
                  "hasIdSuffix": "header_pay"
                },
                "read": "text",
                "transform": "parseCurrency"
              },
              {
                "find": {
                  "hasTextMatchesRegex": "^\\$[\\d,]+\\.\\d{2}$"
                },
                "read": "text",
                "transform": "parseCurrency"
              }
            ]
          },
          "sessionDurationMillis": {
            "find": {
              "all": [
                {
                  "hasIdSuffix": "name"
                },
                {
                  "hasTextContaining": "Total online time"
                }
              ]
            },
            "navigate": "sibling(1)",
            "read": "text",
            "transform": "parseHrMin",
            "fallback": 0
          },
          "offersAccepted": {
            "find": {
              "all": [
                {
                  "hasIdSuffix": "name"
                },
                {
                  "hasTextContaining": "Offers accepted"
                }
              ]
            },
            "navigate": "sibling(1)",
            "read": "text",
            "transform": {
              "regex": {
                "pattern": "(\\d+)\\s*out of",
                "group": 1,
                "then": "toInt"
              }
            },
            "fallback": 0
          },
          "offersTotal": {
            "find": {
              "all": [
                {
                  "hasIdSuffix": "name"
                },
                {
                  "hasTextContaining": "Offers accepted"
                }
              ]
            },
            "navigate": "sibling(1)",
            "read": "text",
            "transform": {
              "regex": {
                "pattern": "out of\\s*(\\d+)",
                "group": 1,
                "then": "toInt"
              }
            },
            "fallback": 0
          },
          "weeklyEarnings": {
            "find": {
              "all": [
                {
                  "hasIdSuffix": "name"
                },
                {
                  "hasTextContaining": "Earnings this week"
                }
              ]
            },
            "navigate": "sibling(1)",
            "read": "text",
            "transform": "parseCurrency"
          }
        }
      },
      "validate": [
        {
          "assert": "fieldsLe",
          "field": "totalEarnings",
          "le": "weeklyEarnings",
          "tolerance": 0.02,
          "onFail": "dropParsed"
        }
      ],
      "effects": [
        {
          "screenshot": {
            "prefix": "DashSummary - {totalEarnings}",
            "category": "dash_summary"
          },
          "dedupeKey": "dash-summary-ss-{totalEarnings}-{sessionDurationMillis}",
          "throttleMs": 60000
        }
      ]
    },
    {
      "comment": "#796 — the transient 'Navigate to zone' map/loading overlay: a 'Navigate to zone' banner + a '<STATE>: <zone name>' label + the Safety/Help actions, usually over a `loading_view`, shown while the app is routing the dasher toward a zone. RECOGNIZE-ONLY (dev decision 2026-07-17, batch #796): no state.flow, no parse — this is a mid-transition loading overlay, not a lifecycle anchor. This is DISTINCT from doordash.screen.dash_along_the_way (111), the idle order-less repositioning card, which additionally carries 'We'll look for orders along the way' / 'Spot saved until' / the navigate_button+bottom_view_info_title id-form — guards these frames legitimately lack. Priority 125 evaluates AFTER dash_along_the_way (111), so any frame dash_along_the_way matches is claimed by it first (all 11 'Navigate to zone' corpus frames live in dash_along_the_way and are claimed there); this rule only catches the leftover loading overlay, changing NO existing corpus classification. The rejects are load-bearing for PRIVACY: a variant of this overlay that also carries a pickup order card (user_name / user_name_label 'Delivery for <customer>' + 'Order includes') carries a customer name in an id-less/marker-less split-node shape and is DELIBERATELY left UNKNOWN (rejected here) rather than recognized without a redact — that pickup-card-over-zone compound is a separate pickup-recognition gap flagged for follow-up, out of scope for this recognize-only batch. The idle-card rejects ('We'll look for orders along the way' / 'Spot saved until') are belt-and-suspenders on top of the priority ordering. Alternative considered and deferred: folding this into dash_along_the_way's idle/online state — plausible (it is a repositioning-to-zone moment) but the loading overlay lacks the order-less-repositioning confirmation this batch treats as recognize-only.",
      "id": "doordash.screen.dash_navigate_to_zone_loading",
      "priority": 125,
      "reject": [
        {
          "exists": {
            "hasIdSuffix": "user_name"
          }
        },
        {
          "exists": {
            "hasIdSuffix": "user_name_label"
          }
        },
        {
          "exists": {
            "hasIdSuffix": "customer_name_label"
          }
        },
        {
          "exists": {
            "hasTextContaining": "Order includes"
          }
        },
        {
          "exists": {
            "hasTextContaining": "We'll look for orders along the way"
          }
        },
        {
          "exists": {
            "hasTextContaining": "Spot saved until"
          }
        }
      ],
      "require": {
        "exists": {
          "hasTextContaining": "Navigate to zone"
        }
      }
    }
  ],
  "clicks": [
    {
      "id": "doordash.click.start_dash_set_end_time",
      "priority": 5,
      "screenIs": "set_dash_end_time",
      "intent": "start_dash_set_end_time",
      "state": {
        "modeHint": "online"
      },
      "require": {
        "hasIdSuffix": "end_time_container"
      }
    },
    {
      "id": "doordash.click.end_dash",
      "priority": 6,
      "screenIs": "timeline",
      "intent": "end_dash",
      "state": {
        "modeHint": "offline"
      },
      "require": {
        "hasText": "End dash"
      }
    },
    {
      "id": "doordash.click.resume_dash",
      "priority": 40,
      "screenIs": "dash_paused",
      "intent": "resume_dash",
      "state": {
        "modeHint": "online"
      },
      "require": {
        "hasIdSuffix": "resumeButton"
      }
    }
  ]
}
