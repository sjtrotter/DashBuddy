// Section: Pickup — navigation, arrival, shopping, item verification, issue/resolution sub-screens.
{
  "$schema": "../../../docs/rules.fragment.schema.json",
  "screens": [
    {
      "id": "doordash.screen.pickup_navigation",
      "priority": 60,
      "state": {
        "flow": "task:pickup:navigation",
        "modeHint": "online"
      },
      "reject": [
        {
          "exists": {
            "all": [
              {
                "hasIdSuffix": "bottom_sheet_task_title"
              },
              {
                "hasTextContaining": "Deliver to"
              }
            ]
          }
        },
        {
          "exists": {
            "all": [
              {
                "hasIdSuffix": "bottom_sheet_task_arrive_by"
              },
              {
                "hasTextContaining": "Deliver by"
              }
            ]
          }
        }
      ],
      "require": {
        "exists": {
          "hasIdSuffix": "bottom_sheet_task_title"
        }
      },
      "parse": {
        "as": "task",
        "fields": {
          "phase": "PICKUP",
          "subFlow": "NAVIGATION",
          "storeName": {
            "find": {
              "hasIdSuffix": "bottom_sheet_task_title"
            },
            "read": "text",
            "transform": {
              "stripPrefixes": [
                "Heading to ",
                "Pick up at "
              ]
            }
          },
          "storeAddress": {
            "join": [
              {
                "find": {
                  "hasIdSuffix": "bottom_sheet_address_line_1"
                },
                "read": "text"
              },
              {
                "find": {
                  "hasIdSuffix": "bottom_sheet_address_line_2"
                },
                "read": "text"
              }
            ],
            "separator": ", "
          },
          "deadlineText": {
            "find": {
              "hasIdSuffix": "bottom_sheet_task_arrive_by"
            },
            "read": "text",
            "transform": "stripDeadlinePrefix"
          },
          "deadlineMillis": {
            "find": {
              "hasIdSuffix": "bottom_sheet_task_arrive_by"
            },
            "read": "text",
            "transform": "parseDeadline"
          }
        }
      }
    },
    {
      "id": "doordash.screen.pickup_arrival",
      "priority": 70,
      "redact": [
        {
          "find": {
            "hasIdSuffix": "customer_name"
          },
          "normalize": "customerName"
        }
      ],
      "state": {
        "flow": "task:pickup:arrived",
        "modeHint": "online"
      },
      "bind": {
        "contactView": {
          "find": {
            "hasIdSuffix": "mx_contact_view"
          },
          "optional": true
        }
      },
      "require": {
        "all": [
          {
            "exists": {
              "all": [
                {
                  "hasIdSuffix": "customer_name_label"
                },
                {
                  "hasTextContaining": "Order for"
                }
              ]
            }
          },
          {
            "exists": {
              "all": [
                {
                  "hasIdSuffix": "textView_prism_button_title"
                },
                {
                  "any": [
                    {
                      "hasTextContaining": "Confirm"
                    },
                    {
                      "hasTextContaining": "Continue"
                    },
                    {
                      "hasTextContaining": "Start"
                    }
                  ]
                }
              ]
            }
          }
        ]
      },
      "parse": {
        "as": "task",
        "fields": {
          "phase": "PICKUP",
          "subFlow": "ARRIVED",
          "storeName": {
            "from": "contactView",
            "find": {
              "hasIdSuffix": "instructions_title"
            },
            "read": "text"
          },
          "customerNameHash": {
            "find": {
              "hasIdSuffix": "customer_name"
            },
            "read": "text",
            "transform": [
              "trim",
              "normalizeCustomerName",
              "sha256"
            ]
          },
          "deadlineText": {
            "find": {
              "hasTextStartsWith": "Pick up by"
            },
            "read": "text",
            "transform": "stripDeadlinePrefix"
          },
          "deadlineMillis": {
            "find": {
              "hasTextStartsWith": "Pick up by"
            },
            "read": "text",
            "transform": "parseDeadline"
          },
          "itemCount": {
            "find": {
              "hasIdSuffix": "items_title_v2"
            },
            "read": "text",
            "transform": "parseLeadingInt"
          },
          "redCardTotal": {
            "find": {
              "hasIdSuffix": "banner_label"
            },
            "read": "text",
            "transform": "parseCurrency"
          },
          "arrivalConfirmed": {
            "literal": true
          }
        }
      }
    },
    {
      "id": "doordash.screen.pickup_pre_arrival",
      "priority": 71,
      "redact": [
        {
          "find": {
            "hasIdSuffix": "user_name"
          }
        },
        {
          "find": {
            "hasIdSuffix": "address_line_1"
          }
        },
        {
          "find": {
            "hasIdSuffix": "address_line_2"
          }
        }
      ],
      "state": {
        "flow": "task:pickup:navigation",
        "modeHint": "online"
      },
      "require": {
        "all": [
          {
            "exists": {
              "all": [
                {
                  "hasIdSuffix": "user_name_label"
                },
                {
                  "hasTextContaining": "Pickup from"
                }
              ]
            }
          },
          {
            "any": [
              {
                "exists": {
                  "all": [
                    {
                      "hasIdSuffix": "textView_prism_button_title"
                    },
                    {
                      "any": [
                        {
                          "hasText": "Directions"
                        },
                        {
                          "hasText": "Arrived at store"
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "exists": {
                  "hasIdSuffix": "bottom_sheet_container"
                }
              }
            ]
          }
        ]
      },
      "parse": {
        "as": "task",
        "fields": {
          "phase": "PICKUP",
          "subFlow": "NAVIGATION",
          "storeName": {
            "find": {
              "hasIdSuffix": "user_name"
            },
            "read": "text",
            "transform": {
              "stripPrefixes": [
                "Pickup from ",
                "Heading to ",
                "Pick up at "
              ]
            }
          },
          "storeAddress": {
            "join": [
              {
                "find": {
                  "hasIdSuffix": "address_line_1"
                },
                "read": "text"
              },
              {
                "find": {
                  "hasIdSuffix": "address_line_2"
                },
                "read": "text"
              }
            ],
            "separator": ", "
          },
          "deadlineText": {
            "find": {
              "hasTextStartsWith": "Pick up by"
            },
            "read": "text",
            "transform": "stripDeadlinePrefix"
          },
          "deadlineMillis": {
            "find": {
              "hasTextStartsWith": "Pick up by"
            },
            "read": "text",
            "transform": "parseDeadline"
          },
          "itemCount": {
            "find": {
              "hasIdSuffix": "items_title_v2"
            },
            "read": "text",
            "transform": "parseLeadingInt"
          }
        }
      }
    },
    {
      "id": "doordash.screen.pickup_shopping",
      "priority": 72,
      "state": {
        "flow": "task:pickup:arrived",
        "modeHint": "online"
      },
      "require": {
        "all": [
          {
            "exists": {
              "hasText": "Shop and Deliver"
            }
          },
          {
            "any": [
              {
                "exists": {
                  "hasIdSuffix": "tab_layout"
                }
              },
              {
                "exists": {
                  "hasTextStartsWith": "To shop"
                }
              }
            ]
          }
        ]
      },
      "parse": {
        "as": "task",
        "fields": {
          "activity": "shopping",
          "phase": "PICKUP",
          "subFlow": "ARRIVED",
          "itemsRemaining": {
            "find": {
              "hasTextMatchesRegex": "To shop \\((\\d+)\\)"
            },
            "read": "text",
            "transform": {
              "regex": {
                "pattern": "\\((\\d+)\\)",
                "group": 1,
                "then": "toInt"
              }
            }
          },
          "itemsShopped": {
            "find": {
              "hasTextMatchesRegex": "Done \\((\\d+)\\)"
            },
            "read": "text",
            "transform": {
              "regex": {
                "pattern": "\\((\\d+)\\)",
                "group": 1,
                "then": "toInt"
              }
            }
          }
        }
      }
    },
    {
      "id": "doordash.screen.pickup_verify_items",
      "priority": 76,
      "redact": [
        {
          "find": {
            "hasIdSuffix": "order_verification_checklist_title"
          },
          "keepPrefix": [
            "Verify items for "
          ],
          "normalize": "customerName"
        }
      ],
      "state": {
        "flow": "task:pickup:arrived",
        "modeHint": "online"
      },
      "require": {
        "all": [
          {
            "exists": {
              "hasTextContaining": "Verify items for"
            }
          },
          {
            "exists": {
              "hasText": "Do not open sealed bags"
            }
          }
        ]
      },
      "parse": {
        "as": "task",
        "fields": {
          "phase": "PICKUP",
          "subFlow": "ARRIVED"
        }
      }
    },
    {
      "id": "doordash.screen.pickup_wait_survey",
      "priority": 88,
      "comment": "#992 — this rule shipped with NO redact block at all, while the fielded frames (2026-08-07 19:46:17 / 19:47:10) carry the at-store contact card's bare `customer_name` node verbatim on a RECOGNIZED surface. `CustomerTextMarkers.ID_MARKERS` already lists `customer_name`, but that scan is UNKNOWN-envelope-only BY DESIGN (#910), so a recognized rule that forgets to redact has no backstop — the exact 'mechanism 1' class the ruleset must own. The node has no in-node lead-in either ('Order for' is a separate `customer_name_label` sibling), so the TEXT-marker backstop is structurally blind to it too: the same split-node shape #526 D6a documents for `pickup_arrival`. Entry mirrors `pickup_arrival`/`pickup_post_arrival_multi`/`pickup_pre_arrival_multi` byte-for-byte (`normalize: customerName`) so one customer masks to ONE hex across every pickup surface and that hex stays equal to the persisted `customerNameHash`. Recognize-only rule: a redact without a parse is legal (the `pickup_select_issue`/`pickup_post_arrival_multi` precedent) and the parse goldens are untouched. `instructions_title` (the MERCHANT) and the survey/item chrome stay raw — merchant + item text is driver-owned, not customer PII.",
      "redact": [
        {
          "find": {
            "hasIdSuffix": "customer_name"
          },
          "normalize": "customerName"
        },
        {
          "comment": "#995 belt: this rule (priority 88) BEATS `pickup_receipt_scan` (141) on a TRANSITION frame that still carries surviving wait-survey anchors while the scan overlay's nodes have already inflated — the fielded 08-07 sequence puts the survey at 19:46:17 and the scan at 19:46:54 on the same job, so the interleaving frame is a real shape, not a hypothetical. Byte-identical to the scan rule's two entries (see `pickup_receipt_scan` for the full reasoning), so one customer masks to one hex whichever rule wins. Inert on a plain survey frame, which carries neither node.",
          "find": {
            "hasTextStartsWith": "Focus on "
          },
          "keepPrefix": [
            "Focus on "
          ],
          "normalize": "customerName"
        },
        {
          "find": {
            "all": [
              {
                "hasNoId": true
              },
              {
                "hasTextMatchesRegex": "^\\s{0,8}[\\p{L}][\\p{L}'-]{0,20}(\\s{1,4}[\\p{L}][\\p{L}'-]{0,20}){0,3}\\s{1,4}[A-Z]\\.?\\s{0,8}$"
              }
            ]
          },
          "normalize": "customerName"
        }
      ],
      "branches": [
        {
          "comment": "Normal DoorDash wait survey.",
          "require": {
            "all": [
              {
                "exists": {
                  "hasTextContaining": "What's causing your wait"
                }
              },
              {
                "exists": {
                  "hasTextContaining": "Order still being prepared when I arrived"
                }
              }
            ]
          }
        },
        {
          "comment": "#501 GoPuff (Drive) at-store wait survey — recognize-only (inherits the parent's no-state), keyed on the GoPuff survey container id + 'Waiting for your order'. Rejects the bin-scan STEPS screen (which also carries pickup_survey_view) so the higher-numbered pickup_steps arrival branch wins it (lower priority = evaluated first, so this 88 must not steal the 104 steps frame).",
          "reject": [
            {
              "exists": {
                "hasTextContaining": "Pickup steps"
              }
            }
          ],
          "require": {
            "all": [
              {
                "exists": {
                  "hasIdSuffix": "pickup_survey_view"
                }
              },
              {
                "exists": {
                  "hasTextContaining": "Waiting for your order"
                }
              }
            ]
          }
        },
        {
          "comment": "#888 — the DoorDash wait survey's SHEET variant: same 'What's causing your wait?' banner + Submit, but rendered as the wait_survey_container scroll sheet whose reason list has not inflated yet, so branch 1's 'Order still being prepared when I arrived' option anchor is absent and the frame fell to UNKNOWN (2026-07-26 21:08:27 in the pull, ~300ms before the fully-inflated frame branch 1 already recognizes). Anchored on the two survey-specific container/button ids plus the same banner copy branch 1 uses; the ids keep this off any other sheet. Same rule, same intent, same recognize-only posture.",
          "require": {
            "all": [
              {
                "exists": {
                  "hasIdSuffix": "wait_survey_container"
                }
              },
              {
                "exists": {
                  "hasIdSuffix": "btn_submit_survey"
                }
              },
              {
                "exists": {
                  "hasTextContaining": "What's causing your wait"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "comment": "#995 — DoorDash's receipt-scan camera flow ('Scan receipt' → 'Scan the order details by focusing on the customer name' → the live scan overlay → 'Pickup complete'). DEV RULING 2026-08-09: this is NOT in the blocked document-image family (a license scan / signature pad is an image of an ID or a signature; a receipt is neither) — capturing the surface's TEXT is fine, but the customer name on it is a customer name like any other and is redacted like the rest (#463 recognize-and-hash doctrine). It reached the pledge floor because NOTHING covered it: the two name nodes carry no view id (so `CustomerTextMarkers.ID_MARKERS` misses), no enumerated text prefix (so `MARKERS` misses), and no rule (so there was no `redact` to declare) — the frames fell to UNKNOWN with the name verbatim, twice per frame (fielded 2026-08-07 19:46:54–19:47:05, 6 envelopes). RECOGNIZE-ONLY on purpose: no `state.flow` and no `parse`. The surface adds no lifecycle edge the existing pickup rules do not already own (the arrival/confirm anchors sit on `pickup_arrival`/`pickup_picked_up`), so giving it a flow would be a state-machine change riding on a privacy fix; the rule's whole job is to give the frame a `redact` block. **Recognize-only is NOT state-INERT, and the distinction is load-bearing:** `AccessibilityPipeline.output()` drops UNKNOWN frames BEFORE the state machine, so ruling a previously-UNKNOWN surface genuinely changes behaviour — these frames now reach the machine as observations at all, and they update `FrameGate`'s `lastIdentity`, which changes which SUBSEQUENT frames are admitted. What no `state` block buys is NEUTRALITY, not invisibility: no flow, no modeHint, therefore no session/task lifecycle movement and no events. That is asserted end-to-end (real classifier + real StateMachine over the committed fixtures) by `FlowlessRecognitionNeutralityTest`, which also pins that the frame cannot assert a mode from absence — the #857/#874/#875 forged-state class — rather than leaving the claim to this comment. ANCHORS ARE PLATFORM CHROME, NEVER THE NAME (and never a merchant): the two require strings are DoorDash's own fixed scan copy, both corpus-unique (zero hits across every committed snapshot) and jointly covering all three fielded renders — the intro sheet alone ('Scan the order details…'), the live overlay alone ('Scan customer name'), and the frame that carries both. Priority is inert here: no other rule matches these trees today (they classified UNKNOWN), and neither anchor appears on any other surface. The rules-independent `CustomerTextMarkers` backstop is deliberately NOT extended with a 'Focus on ' marker — see that SSOT's deliberate-exclusions KDoc (DoorDash's own shopping-accuracy tip copy starts 'Focus on accuracy…'); this redact is the primary control, per the #806 doctrine.",
      "id": "doordash.screen.pickup_receipt_scan",
      "priority": 141,
      "redact": [
        {
          "comment": "The id-less instruction line 'Focus on <FirstName L>'. Ordered FIRST because the bare-name shape entry below would also match this string ('Focus on Jeremy S' satisfies the first-last-initial shape), and this entry keeps the 'Focus on ' lead-in so a replayed envelope still reads as the scan instruction. `normalize: customerName` keeps the mask hex equal to the customer's persisted `customerNameHash` (#623/#733) — customerNameKey strips to first-token + second-token-initial, so 'Focus on ' + name masks to the same 4hex this customer gets on every pickup/dropoff surface.",
          "find": {
            "hasTextStartsWith": "Focus on "
          },
          "keepPrefix": [
            "Focus on "
          ],
          "normalize": "customerName"
        },
        {
          "comment": "The BARE name node rendered beside the scan target. No id, no lead-in, so the only handle is the shared first-last-initial name SHAPE — byte-SSOT with SnapshotRedactor.FIRST_LAST_INITIAL_PATTERN (the `\\s{1,4}` interior separator is #885's fix). The parity test `CaptureRedactionCorpusTest.the id-less name-shape redact pattern is SSOT with SnapshotRedactor` pins the copies it ENUMERATES — this rule was added to that list in the same pass, because a hand-copy that is not enumerated there is exactly the drift the test exists to stop. `hasNoId` keeps it off id-bearing chrome, and `hasTextMatchesRegex` reads `text` only, so the desc-only chrome nodes ('Close'/'Flash off'/'Info') are untouched. Over-match audit on this surface: every other text node fails the shape — 'Scan customer name', 'Scan receipt', 'No receipt', 'Pickup complete', 'Start scanning', 'Continue', '0:05' and the two body paragraphs all end in a multi-letter token, and '#fddcf · DoorDash' does not start with a letter — so nothing but the name is masked.",
          "find": {
            "all": [
              {
                "hasNoId": true
              },
              {
                "hasTextMatchesRegex": "^\\s{0,8}[\\p{L}][\\p{L}'-]{0,20}(\\s{1,4}[\\p{L}][\\p{L}'-]{0,20}){0,3}\\s{1,4}[A-Z]\\.?\\s{0,8}$"
              }
            ]
          },
          "normalize": "customerName"
        }
      ],
      "require": {
        "any": [
          {
            "exists": {
              "hasTextContaining": "Scan customer name"
            }
          },
          {
            "exists": {
              "hasTextContaining": "Scan the order details by focusing on the customer name"
            }
          }
        ]
      }
    },
    {
      "id": "doordash.screen.pickup_issue_menu",
      "priority": 87,
      "require": {
        "exists": {
          "hasTextContaining": "what pickup issues can we help with"
        }
      }
    },
    {
      "id": "doordash.screen.pickup_picked_up",
      "priority": 98,
      "state": {
        "flow": "task:pickup:arrived",
        "modeHint": "online"
      },
      "require": {
        "allTextContainsAll": [
          "confirm pickup",
          "loading"
        ]
      }
    },
    {
      "id": "doordash.screen.pickup_post_arrival_multi",
      "priority": 99,
      "redact": [
        {
          "comment": "#910 V2 — the multi-order pickup list renders ONE row per order, each carrying a bare `customer_name` node (the fielded 07-28 frames carry three), and this rule shipped with no redact block, so every one reached the recognized envelope raw. The node has no in-node lead-in ('Order for' is a separate sibling on the single-order card), so `CustomerTextMarkers` is structurally blind to it — the same split-node shape #526 D6a documents for `pickup_arrival`, whose identical `customer_name` + `normalize: customerName` entry this mirrors so a customer's mask hex matches across surfaces and the persisted `customerNameHash`. Recognize-only rule: redact without parse is legal (the `pickup_select_issue` precedent) and the parse goldens are untouched. `merchant_name` stays raw (the merchant is driver-owned data, not PII); so do `num_items`/`header_text`/`description_text`, which are app chrome.",
          "find": {
            "hasIdSuffix": "customer_name"
          },
          "normalize": "customerName"
        }
      ],
      "state": {
        "flow": "task:pickup:arrived",
        "modeHint": "online"
      },
      "reject": [
        {
          "allTextContains": "confirm at store"
        },
        {
          "allTextContains": "customer"
        }
      ],
      "require": {
        "allTextContainsAll": [
          "pick up",
          "orders",
          "you have",
          "orders to pick up at",
          "pick up each one to continue"
        ]
      }
    },
    {
      "id": "doordash.screen.pickup_pre_arrival_multi",
      "priority": 100,
      "redact": [
        {
          "comment": "#910 V3 — the pre-arrival twin of `pickup_post_arrival_multi` (same list, before 'Confirm at store'); the fielded 07-28 frame carries the same bare `customer_name` node. Same entry, same reasoning, same `normalize: customerName` so the mask hex is one-customer-one-hex across both surfaces.",
          "find": {
            "hasIdSuffix": "customer_name"
          },
          "normalize": "customerName"
        }
      ],
      "state": {
        "flow": "task:pickup:navigation",
        "modeHint": "online"
      },
      "require": {
        "allTextContainsAll": [
          "confirm at store",
          "orders",
          "you have",
          "orders to pick up at",
          "pick up each one to continue"
        ]
      }
    },
    {
      "id": "doordash.screen.pickup_verify",
      "priority": 101,
      "state": {
        "flow": "task:pickup:arrived",
        "modeHint": "online"
      },
      "reject": [
        {
          "allTextContains": "pick up by"
        }
      ],
      "require": {
        "allTextContainsAll": [
          "verify order",
          "order for",
          "confirm pickup",
          "can't verify order"
        ]
      }
    },
    {
      "comment": "The pickup 'Select an issue' list. #809: carries the SAME 'For <customer> • <store>' redact as its sibling resolution surfaces (pickup_resolution_options / pickup_unassign_survey). Recognize-only (no parse), so redact-without-parse is legal (the survey precedent); the fused header node's post-'For ' remainder — customer name AND the ' • <store>' tail — is masked to '[redacted:<4hex>]', so the store tail does NOT survive. That is fine here: no anchor or parse rides the header line (the anchors are the separate 'Select an issue' + option nodes), and no other rule reads this surface's store from that node. B3 (#810 design): a SECOND branch recognizes the option-set variant that lacks 'Order already picked up'.",
      "id": "doordash.screen.pickup_select_issue",
      "priority": 102,
      "redact": [
        {
          "find": {
            "hasTextStartsWith": "For "
          },
          "keepPrefix": [
            "For "
          ],
          "normalize": "customerName"
        }
      ],
      "branches": [
        {
          "comment": "Original 'Select an issue' list reached via the already-picked-up path.",
          "require": {
            "all": [
              {
                "exists": {
                  "hasTextContaining": "Select an issue"
                }
              },
              {
                "exists": {
                  "hasTextContaining": "Order already picked up"
                }
              }
            ]
          }
        },
        {
          "comment": "#809 B3 — the 'Select an issue' variant option-set (Red Card issues / vehicle crash / 'It's something else' / 'I have an issue') that lacks the 'Order already picked up' option; session-114 (2026-07-19 14:20:59) fell to UNKNOWN. Same surface, same intent, recognize-only. The reject of 'Resolution options' is load-bearing: the deeper combined resolution panel (pickup_resolution_options, priority 103) scrolls this SAME issue list above its own 'Resolution options' content, so it also carries 'Select an issue' + 'It's something else' — and because 102 evaluates before 103, without this belt a resolution frame would misclassify as select_issue. Anchor discipline (#738): 'Select an issue' + 'It's something else' + reject 'Resolution options' is corpus-unique (verified: no non-resolution frame carries both anchors).",
          "reject": [
            {
              "exists": {
                "hasTextContaining": "Resolution options"
              }
            }
          ],
          "require": {
            "all": [
              {
                "exists": {
                  "hasTextContaining": "Select an issue"
                }
              },
              {
                "exists": {
                  "hasTextContaining": "It's something else"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "comment": "Deeper than pickup_select_issue — the resolution panel reached after picking an issue. Keyed on its own distinctive strings so it never overlaps the issue list.",
      "id": "doordash.screen.pickup_resolution_options",
      "priority": 103,
      "redact": [
        {
          "find": {
            "hasTextStartsWith": "For "
          },
          "keepPrefix": [
            "For "
          ],
          "normalize": "customerName"
        }
      ],
      "require": {
        "all": [
          {
            "exists": {
              "hasTextContaining": "Resolution options"
            }
          },
          {
            "exists": {
              "any": [
                {
                  "hasTextContaining": "Unassign with no pay"
                },
                {
                  "hasTextContaining": "Wait for the order"
                },
                {
                  "hasTextContaining": "unassign and move on to the next task"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "comment": "#736 A1 — the platform's own authoritative statement that the dasher UNASSIGNED the order (via help/resolution). STATE-BEARING (task:unassigned) so the state machine can inline-abandon the active task instead of the retire-grace fabricating a PICKUP_CONFIRMED (the seq-71 bug). Requires BOTH anchors so it is structurally unambiguous: the help article ('Unassigning order …') and the resolution panel ('unassign and move on …') each match NEITHER. Uses 'been unassigned' (not 'You've been…') to dodge the apostrophe-variant risk. Priority 107 (< the survey's 108) so the combined confirmation-over-survey frame classifies here; the survey also rejects this anchor as a belt. Carries the SAME 'For <customer> • <store>' redact as pickup_resolution_options/pickup_unassign_survey: this state-bearing rule wins a combined confirmation-over-survey frame (survey rejects the confirmation anchor), so it must own that frame's customer line too — a redact with no matching node is simply inert (this rule has no parse, so redact-without-parse is legal, per the survey precedent).",
      "id": "doordash.screen.pickup_unassigned_confirmation",
      "priority": 107,
      "redact": [
        {
          "find": {
            "hasTextStartsWith": "For "
          },
          "keepPrefix": [
            "For "
          ],
          "normalize": "customerName"
        }
      ],
      "state": {
        "flow": "task:unassigned",
        "modeHint": "online"
      },
      "require": {
        "all": [
          {
            "exists": {
              "hasTextContaining": "been unassigned from this order"
            }
          },
          {
            "exists": {
              "hasTextContaining": "continue to your next stop"
            }
          }
        ]
      }
    },
    {
      "comment": "#736 A2 — the unassign survey ('Tell us what happened…'). Recognize-only (the pickup_wait_survey precedent: silences the UNKNOWN, cannot perturb the machine — the state-bearing confirmation is the authoritative signal). Rejects 'been unassigned from this order' as a belt so the combined confirmation-over-survey frame can never fall here even if priorities are later reshuffled. Redacts the 'For <customer> • <store>' line (same pattern as pickup_resolution_options).",
      "id": "doordash.screen.pickup_unassign_survey",
      "priority": 108,
      "redact": [
        {
          "find": {
            "hasTextStartsWith": "For "
          },
          "keepPrefix": [
            "For "
          ],
          "normalize": "customerName"
        }
      ],
      "reject": [
        {
          "exists": {
            "hasTextContaining": "been unassigned from this order"
          }
        }
      ],
      "require": {
        "all": [
          {
            "exists": {
              "hasTextContaining": "Unassign order"
            }
          },
          {
            "exists": {
              "hasTextContaining": "Tell us what happened so we can make the pickup experience better"
            }
          }
        ]
      }
    },
    {
      "comment": "#462 batch 1 — recognize-only interstitials/menus/surveys so they no longer fall to UNKNOWN. No state.flow (cannot perturb the machine) and no parse (no PII). Keyed on 2+ stable non-PII strings.",
      "id": "doordash.screen.pickup_steps",
      "priority": 104,
      "branches": [
        {
          "comment": "Normal DoorDash pickup steps (receipt photo / confirm pickup) — recognize-only.",
          "require": {
            "all": [
              {
                "exists": {
                  "hasTextContaining": "Pickup steps"
                }
              },
              {
                "exists": {
                  "any": [
                    {
                      "hasTextContaining": "Take receipt photo"
                    },
                    {
                      "hasTextContaining": "Confirm pickup"
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "comment": "#501 GoPuff (Drive) warehouse bin-scan steps — the batch's at-store pickup workflow ('Scan barcodes on N items' / 'Complete pickup'). The whole warehouse leg is otherwise all-UNKNOWN, so no PICKUP_ARRIVED ever fired; declaring task:pickup:arrived here mints one clean, obs.timestamp-anchored arrival. No parse → no customer PII read (the per-order order_cx_name names are ignored); the flow alone drives the arrival, and EffectMap's null→non-null arrivedAt idempotency prevents any double-mint.",
          "state": {
            "flow": "task:pickup:arrived",
            "modeHint": "online"
          },
          "require": {
            "all": [
              {
                "exists": {
                  "hasTextContaining": "Pickup steps"
                }
              },
              {
                "exists": {
                  "hasTextContaining": "Scan barcodes on"
                }
              },
              {
                "exists": {
                  "hasTextContaining": "Complete pickup"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "comment": "#501 GoPuff (Drive) barcode-scan failure sub-screen of the bin-scan workflow ('Enter last 4 characters of barcode'). A bare Compose tree (no doordash widget ids), so keyed on stable text only. Recognize-only (no state) — it's a mid-pickup sub-screen and must not change phase; keeps the bin-scan stretch out of UNKNOWN.",
      "id": "doordash.screen.pickup_barcode_scan_issue",
      "priority": 105,
      "require": {
        "all": [
          {
