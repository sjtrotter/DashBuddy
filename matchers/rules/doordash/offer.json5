  ],
  "clicks": [
    {
      "id": "doordash.click.accept_offer",
      "priority": 10,
      "screenIs": "offer_popup",
      "intent": "accept_offer",
      "state": {
        "modeHint": "online"
      },
      // #1114: the 8.97.8 Compose card's Accept is an id-less clickable View whose subtree is
      // `Accept` + the countdown. Compose taps produced NO click envelopes in the 09-18/19 field
      // data, so the SOURCE node a Compose click would carry is unobserved — the arm asserts only
      // the label (exact `Accept` in the clicked node's subtree, and no `Decline`, so a root-sized
      // source never reads as an accept) and leans on `screenIs` for scope. A tap that never
      // arrives is covered by the click-less accept inference on the pickup-phase exit. Compose taps
      // produced no click envelopes in the 09-18/19 field data at all; the arm is here so a tap that
      // DOES arrive is classified, and the accept is otherwise inferred from the pickup-phase exit.
      "require": {
        "any": [
          {
            "hasIdSuffix": "accept_button"
          },
          {
            "all": [
              {
                "hasAnyText": "Accept"
              },
              {
                "not": {
                  "hasAnyText": "Decline"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "doordash.click.initial_decline",
      "priority": 15,
      "screenIs": "offer_popup",
      "intent": "initial_decline",
      "state": {
        "modeHint": "online"
      },
      // #1114: Compose arm — exact `Decline` in the clicked node's subtree and no `Accept`
      // (`hasAnyText` is whole-token equality, so the confirm sheet's `Decline offer` never
      // matches this rule). Compose taps produced NO click envelopes in the 09-18/19 field data,
      // so the SOURCE node shape is unobserved: no clickable/no-id assumption, `screenIs` scopes.
      "require": {
        "any": [
          {
            "hasIdSuffix": "secondary_action_button_dash_plus"
          },
          {
            "all": [
              {
                "hasAnyText": "Decline"
              },
              {
                "not": {
                  "hasAnyText": "Accept"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "comment": "#1104 (fielded 2026-09-10 and again 09-12): the confirm tap RACES its own sheet. The click sub-pipeline and the window sub-pipeline are independent, and the dasher's tap on 'Decline offer' is dispatched 24-229 ms BEFORE the confirm sheet's frame is admitted — so the classifier still holds `offer_popup` as DoorDash's last screen target, the single-valued `screenIs` rejected the branch, the click fell to UNKNOWN, and the offer sat presented until it expired (the decline was never recorded as a decline). Widening the constraint to BOTH targets is safe because the NODE is unambiguous: this rule anchors on the exact label 'Decline offer' (#734), which only the confirm sheet's button renders — the offer card's own control is a bare 'Decline' claimed by `initial_decline` on its `secondary_action_button_dash_plus` id, so the two cannot collide on either target. The constraint stays a real gate: both accepted targets are enumerated, and the tap is still rejected on every other screen. This closes the FIELDED shape only; the general click-vs-window ordering race stays open on #1104.",
      "id": "doordash.click.decline_offer",
      "priority": 20,
      "screenIs": [
        "offer_popup_confirm_decline",
        "offer_popup"
      ],
      "intent": "decline_offer",
      "state": {
        "modeHint": "online"
      },
      // #1114: the 8.97.8 confirm sheet renders TWO commit labels — `Decline offer` and, for Gold
      // dashers, `Decline & pause store` (fielded 09-18 17:18). Both commit the decline; both are
      // recorded as one. The pause variant is recorded here but never auto-tapped (see the
      // confirmDeclineButton bind).
      "require": {
        "any": [
          {
            "hasAnyText": "Decline offer"
          },
          {
            "hasAnyText": "Decline & pause store"
          }
        ]
      }
    }
  ]
}
