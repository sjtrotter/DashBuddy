// Section: Sensitive — dasher banking/identity + document-image capture surfaces (blocked at the matcher layer; the load-time sensitive-coverage guard requires the two sensitive-shaped rules to live here).
{
  "$schema": "../../../docs/rules.fragment.schema.json",
  "screens": [
    {
      "id": "doordash.screen.sensitive.known",
      "priority": 0,
      "overrideable": false,
      "parse": {
        "as": "sensitive"
      },
      "branches": [
        {
          "comment": "#924: the DasherDirect entry frame is STRUCTURE-gated, not content-gated. Every other arm of this branch keys on rendered banking TEXT ('Crimson'), so the nav host's own pre-render skeleton — `dxdr_nav_host_fragment` + `loading_layout` + an empty ComposeView, fielded 2026-07-29 19:16:46 — carried no marker at all and fell to UNKNOWN capture. No leak occurred (the skeleton has no text; the 21 subsequent rendered frames were all correctly blocked), but the gate should close at the DOOR: `dxdr_nav_host_fragment` is DasherDirect's own nav-host container id, so it is present on EVERY frame of that surface, before and after the banking content inflates. Same priority-0 `overrideable: false` posture as its siblings (structurally first — see the #419 partition), and an id anchor is also LOCALE-IMMUNE where a text anchor is not (#938/#910). Over-match surface: the id is DasherDirect-specific and appears on no delivery/offer surface across the committed corpus or any pull, and over-blocking a banking surface is the safe direction by Pledge anyway.",
          "intent": "sensitive.dasher_direct",
          "require": {
            "exists": {
              "any": [
                {
                  "hasIdSuffix": "dasher_direct_auth"
                },
                {
                  "hasIdSuffix": "dasher_direct_payout_config_compose_view"
                },
                {
                  "hasIdSuffix": "dxdr_nav_host_fragment"
                },
                {
                  "hasTextContaining": "DoorDash Crimson"
                },
                {
                  "hasText": "Crimson"
                }
              ]
            }
          }
        },
        {
          "intent": "sensitive.card_details",
          "require": {
            "all": [
              {
                "exists": {
                  "hasText": "CVV"
                }
              },
              {
                "exists": {
                  "hasText": "Expiry"
                }
              }
            ]
          }
        },
        {
          "comment": "#1059: the dasher's OWN Red Card wallet screen ('Your Red Card' — virtual card art, 'Added to Google Pay', activate/request a physical card), fielded 2026-08-27 17:44 and reaching UNKNOWN capture on the shipped ruleset. This is the dasher's payment-card MANAGEMENT surface, so the payment-screens-blocked doctrine applies: block it, never recognize it. Anchored on the surface's own view ids first (locale-immune, #938/#924 — `virtual_red_card_image` is present before either button inflates), with the two button LABELS as belt-and-braces for a frame whose ids do not render. Over-match surface: none of the four anchors appears anywhere in the committed corpus or in any pull, and — critically — the surface's headline text ('Your Red Card') is deliberately NOT an anchor, because the pickup instruction copy legitimately says 'pay with your Red Card' on ordinary shopping orders.",
          "intent": "sensitive.red_card",
          "require": {
            "exists": {
              "any": [
                {
                  "hasIdSuffix": "virtual_red_card_image"
                },
                {
                  "hasIdSuffix": "activate_physical_card_button"
                },
                {
                  "hasIdSuffix": "request_physical_red_card_button"
                },
                {
                  "hasTextContaining": "Activate a physical card"
                },
                {
                  "hasTextContaining": "Request a physical card"
                }
              ]
            }
          }
        },
        {
          "intent": "sensitive.balance",
          "require": {
            "exists": {
              "hasText": "Available Balance"
            }
          }
        },
        {
          "intent": "sensitive.withdraw",
          "require": {
            "all": [
              {
                "exists": {
                  "hasText": "Withdraw"
                }
              },
              {
                "exists": {
                  "hasTextContaining": "available"
                }
              }
            ]
          }
        },
        {
          "intent": "sensitive.transfer",
          "require": {
            "exists": {
              "hasTextContaining": "transfer was initiated"
            }
          }
        },
        {
          // DasherDirect "Transfer out" balance/amount-entry screen (#794): heading
          // "Transfer out" over a "$<balance> available" line, an amount EditText, and a
          // "Continue" button — the dasher's own bank balance. A one-variant coverage gap
          // that leaked the plaintext balance to two UNKNOWN debug captures on 2026-07-17
          // (the copy is "Transfer out"/"$X.XX available", which the "Transfer to bank" rule
          // and "Available Balance" marker both miss). Anchored on the "Transfer out" heading
          // AND a co-present "available" balance line (the same AND shape as sensitive.withdraw
          // /sensitive.savings) — "Transfer out" appears on no recognized customer-facing
          // surface in the corpus, so the pair cannot catch offer/pickup/dropoff/chat screens.
          "intent": "sensitive.transfer_out",
          "require": {
            "all": [
              {
                "exists": {
                  "hasText": "Transfer out"
                }
              },
              {
                "exists": {
                  "hasTextContaining": "available"
                }
              }
            ]
          }
        },
        {
          "intent": "sensitive.savings",
          "require": {
            "any": [
              {
                "exists": {
                  "hasTextContaining": "Savings jar"
                }
              },
              {
                "exists": {
                  "hasTextContaining": "You transferred"
                }
              },
              {
                "all": [
                  {
                    "exists": {
                      "hasText": "Transfer in"
                    }
                  },
                  {
                    "exists": {
                      "hasTextContaining": "available"
                    }
                  }
                ]
              }
            ]
          }
        },
        {
          "comment": "Blocks only the document-CAPTURE surfaces of the alcohol-ID flow — the license-scan camera (an image of a government ID) and the signature pad/handoff. The instruction screens (the ID-check 'verify the ID matches the recipient' and the alcohol arrival card) are NOT blocked: they carry no document image and only customer name/address, which the dropoff parse hashes (we hash customers, we don't block them). See alcohol_id_check + dropoff_pre_arrival. #1059 added the last two alternatives, the PASSPORT variant of that same scanner (fielded 2026-08-28 16:58, reaching UNKNOWN capture): every anchor above is driver's-LICENCE specific, so the document-image surface had NO coverage once the dasher picks another id type. `id_type_selector` is the scanner's own document-type picker id — present on every variant, locale-immune (#938/#924), and absent from the recognized `dropoff_alcohol_id_scan` INSTRUCTION screen (which anchors on 'ID barcode scan' + 'Start scan'), so it blocks the camera without touching the #463/#995 recognize-and-redact instruction surfaces; the 'Align the character strip' scan hint is the locale-bound belt beside it.",
          "intent": "sensitive.id_verification",
          "require": {
            "any": [
              {
                "exists": {
                  "hasTextContaining": "Scan barcode on the back"
                }
              },
              {
                "exists": {
                  "hasTextContaining": "Driver's License"
                }
              },
              {
                "exists": {
                  "hasIdSuffix": "id_type_selector"
                }
              },
              {
                "exists": {
                  "hasTextContaining": "Align the character strip"
                }
              },
              {
                "exists": {
                  "hasTextContaining": "provide their signature"
                }
              },
              {
                "exists": {
                  "hasTextContaining": "ready to start verification"
                }
              },
              {
                "exists": {
                  "hasTextContaining": "A recipient signature is required"
                }
              }
            ]
          }
        },
        {
          "comment": "#1059: the dasher's OWN Persona selfie / identity-verification flow (the embedded Persona SDK: initializing spinner, live selfie camera with 'Center yourself' / 'Look slightly left' hints, the 'take picture' shutter, and the 'We\u2019re having trouble verifying your selfie' retry screen), fielded 2026-08-27 across 12 UNKNOWN envelopes. The frames carry no PII TEXT, but the Pledge blocks document-image capture surfaces as a CLASS (licence scan, signature pad) regardless of content, and a biometric selfie camera of the dasher is squarely in it. Only the flow's ENTRY was covered before ('ready to start verification' above), no step of the capture itself. Anchored on the Persona SDK's own container ids (locale-immune, #938/#924, and the ONLY thing most frames carry — the camera steps are almost entirely text-free): `persona_container` and `pi2_back_stack_screen_runner` on the fragment host, plus `personaComposeView` for the Compose-hosted variant that renders neither. The retry screen's copy is the belt-and-braces text arm. Over-match surface: all four anchors are Persona-SDK-specific and appear on no delivery/offer surface in the committed corpus or any pull.",
          "intent": "sensitive.selfie_verification",
          "require": {
            "exists": {
              "any": [
                {
                  "hasIdSuffix": "persona_container"
                },
                {
                  "hasIdSuffix": "personaComposeView"
                },
                {
                  "hasIdSuffix": "pi2_back_stack_screen_runner"
                },
                {
                  "hasTextContaining": "verifying your selfie"
                }
              ]
            }
          }
        },
        {
          "intent": "sensitive.otp",
          "require": {
            "exists": {
              "hasTextContaining": "Enter the code we sent"
            }
          }
        },
        {
          "intent": "sensitive.linked_accounts",
          "require": {
            "exists": {
              "hasText": "Linked accounts"
            }
          }
        },
        {
          "intent": "sensitive.statements",
          "require": {
            "exists": {
              "hasText": "Statements & documents"
            }
          }
        },
        {
          "intent": "sensitive.payout_settings",
          "require": {
            "exists": {
              "any": [
                {
                  "hasText": "Payout details"
                },
                {
                  "hasTextContaining": "Change payout method"
                },
                {
                  "hasTextContaining": "Recent payout history"
                }
              ]
            }
          }
        },
        {
          "intent": "sensitive.biometric",
          "require": {
            "exists": {
              "any": [
                {
                  "hasTextContaining": "Fingerprint sensor"
                },
                {
                  "hasTextContaining": "Touch the fingerprint"
                },
                {
                  "hasTextContaining": "to secure your account"
                },
                {
                  "hasText": "Use PIN"
                }
              ]
            }
          }
        },
        {
          "intent": "sensitive.account_pii",
          "require": {
            "any": [
              {
                "all": [
                  {
                    "exists": {
                      "hasText": "Personal information"
                    }
                  },
                  {
                    "exists": {
                      "hasText": "First name"
                    }
                  }
                ]
              },
              {
                "all": [
                  {
                    "exists": {
                      "hasTextContaining": "Manage Account"
                    }
                  },
                  {
                    "exists": {
                      "hasTextContaining": "Marketing Choices"
                    }
                  }
                ]
              },
              {
                "exists": {
                  "hasTextContaining": "Request account data"
                }
              },
              {
                "exists": {
                  "hasTextContaining": "Request data archive"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "doordash.screen.sensitive.catchall",
      "priority": 999,
      // A LOW-confidence, last-resort banking-term backstop (priority 999 = evaluated
      // last). It is `overrideable: true` on purpose (#419): specific recognition at a
      // normal priority is MEANT to win over this broad `allTextContainsAny` net, so it
      // must stay in the overrideable partition and keep its last position. The
      // HIGH-confidence, structurally-protected block is `sensitive.known` (priority 0,
      // overrideable: false), which evaluates in the non-overrideable partition first.
      "overrideable": true,
      "require": {
        "allTextContainsAny": [
          "Bank Account",
          "Routing Number",
          "Social Security",
          "Account number",
          "Verify Identity",
          "Debit card",
          "Card status",
          "Lock card",
          "View card details",
          "Linked accounts",
          "Statements & documents",
          "Emergency contact details",
          "Crimson",
          "Biometric",
          "Available Balance",
          "Direct deposit",
          "Withdraw",
          "Expiry",
          "CVV",
          "Enter the code we sent",
          "transfer was initiated",
          "t=completed_view"
        ]
      },
      "parse": {
        "as": "sensitive"
      }
    }
  ]
}
