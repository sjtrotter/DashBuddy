<resources>
    <!-- Dashboard strings (#97) — moved verbatim from :app. Owned by :feature:dashboard. -->

    <!--
      #977 (redesign stage 4): Home became "Today". The old PeriodReview period selector went with
      it, and so did its dashboard_screen_stat_* / common_period_* labels — the four review windows
      now live on the Analytics pager, reachable from the week block's Recap action. (The :app
      copies of common_period_* were the authoritative pair of that #851 duplication and are
      likewise unused since #970 dropped the hub's per-tab selector; they are left in place rather
      than removed from a module this stage doesn't otherwise touch.)
    -->

    <!--
      Today's plan (brief §2). The provenance line is VERBATIM copy: it must always name whose data
      this is and that it is not a promise. Do not soften, shorten, or drop it.
    -->
    <string name="dashboard_plan_title">TODAY\'S PLAN</string>
    <string name="dashboard_plan_provenance_format">from your own %1$s, lifetime — not a guarantee</string>
    <string name="dashboard_plan_best_tonight_format">Best bet tonight: %1$s · your %2$s run %3$s/hr</string>
    <string name="dashboard_plan_best_today_format">Best bet today: %1$s · your %2$s run %3$s/hr</string>
    <string name="dashboard_plan_no_window_format">No clear stretch left today — your %1$s pick up earlier than this.</string>
    <string name="dashboard_plan_thin_data_format">Not enough %1$s on record yet — only %2$s hours have enough data to read.</string>
    <!--
      Recurring-weekday plural ("Monday" → "Mondays"). Its own string so a translation can replace
      the English +s rule with its own form instead of having it welded into the code.
    -->
