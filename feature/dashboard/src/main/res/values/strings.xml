<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dashboard strings (#97) — moved verbatim from :app. Owned by :feature:dashboard. -->

    <!--
      #977 (redesign stage 4): Home became "Today". The old PeriodReview period selector went with
      it, and so did its dashboard_screen_stat_* / common_period_* labels — the four review windows
      now live on the Analytics pager, reachable from the week block's Recap action. (The :app
      copies of common_period_* were the authoritative pair of that #851 duplication and are
      likewise unused since #970 dropped the hub's per-tab selector; they are left in place rather
      than removed from a module this stage doesn't otherwise touch.)

      #1024 section D folded seven Home blocks into four. Three groups of copy went with the
      containers that carried them:
        * dashboard_plan_title — the plan is the lower half of ONE "Today" card now, and the card's
          own label covers both halves (D1);
        * dashboard_plan_provenance_format — retired as a separate line (D2). Provenance did not go
          with it: every plan headline below names the weekday whose record it quotes ("your
          Mondays"), so the sentence is self-describing instead of footnoted;
        * dashboard_today_stat_kept_sub / _net_per_hour_sub (D3) and dashboard_week_frozen_note (D4)
          — the frozen-cost vocabulary has ONE owner per screen now, the shared
          "How these numbers work" footer the host renders (#1024 rule 2).
    -->

    <!-- Today (brief §2 + #1024 D1) — ONE card: the day's record, a hairline, then the day's plan. -->
    <string name="dashboard_today_title">TODAY</string>
    <string name="dashboard_today_stat_kept">Kept</string>
    <string name="dashboard_today_stat_net_per_hour">Net/hr</string>
    <string name="dashboard_today_stat_drops">Drops</string>
    <string name="dashboard_today_stat_miles">Miles</string>
    <string name="dashboard_today_stat_online">Online</string>

    <!-- The plan half of the Today card. Each state names the weekday it is quoting — do not drop it. -->
    <string name="dashboard_plan_best_tonight_format">Best bet tonight: %1$s · your %2$s run %3$s/hr</string>
    <string name="dashboard_plan_best_today_format">Best bet today: %1$s · your %2$s run %3$s/hr</string>
    <string name="dashboard_plan_no_window_format">No clear stretch left — your %1$s pick up earlier.</string>
    <string name="dashboard_plan_thin_data_format">Only %2$s readable hours on your %1$s so far.</string>
    <!--
      Recurring-weekday plural ("Monday" → "Mondays"). Its own string so a translation can replace
      the English +s rule with its own form instead of having it welded into the code.
    -->
    <string name="dashboard_plan_weekday_plural_format">%1$ss</string>

    <!-- This week (brief §2 + #1024 D4) — net + delta + per-day sparkline + Recap, then the plan row. -->
    <string name="dashboard_week_title">THIS WEEK</string>
    <string name="dashboard_week_recap_action">Recap →</string>
    <string name="dashboard_week_delta_up_format">▲ %1$s vs last week</string>
    <string name="dashboard_week_delta_down_format">▼ %1$s vs last week</string>
    <string name="dashboard_week_delta_flat">About the same as last week</string>
    <string name="dashboard_week_delta_from_nothing">Up from nothing last week</string>
    <string name="dashboard_week_delta_none">No earlier week to compare with yet</string>

    <!-- components/WeekCard.kt row 2 — the pointer at the Weekly Plan (#981, brief §2 row 3) -->
    <string name="dashboard_weekly_plan_pointer_title">Your week is planned</string>
    <string name="dashboard_weekly_plan_pointer_detail_format">%1$d target hours across %2$d windows · %3$s projected</string>
    <string name="dashboard_weekly_plan_pointer_action">Plan →</string>
</resources>
