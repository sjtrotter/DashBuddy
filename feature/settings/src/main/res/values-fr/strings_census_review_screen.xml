    <string name="census_review_screen_title">Vérifier un écran</string>
    <string name="census_review_screen_intro">Chaque ligne est ce que gig.log envoie sur un texte de cet écran : un code à sens unique, un format ou un type. Un mot que vous confirmez comme texte propre de l\'app part en texte, et seulement après que d\'autres livreurs l\'ont aussi confirmé. Les lignes masquées restent masquées.</string>
    <string name="census_review_screen_loading">Interrogation du serveur du recensement</string>
    <string name="census_review_screen_shift">Vous pourrez vérifier à la fin de votre service.</string>
    <string name="census_review_screen_tomorrow">Revenez demain. Le serveur du recensement vérifie les mots d\'un écran le lendemain du jour où il le reçoit.</string>
    <string name="census_review_screen_gone">Cette vérification n\'existe plus : elle a été envoyée, supprimée ou date de plus de 7 jours.</string>
    <string name="census_review_screen_not_allowed">La vérification est désactivée, donc gig.log n\'affiche et n\'envoie aucune vérification.</string>
    <string name="census_review_screen_sent">Envoyé. Un mot confirmé est parti sous forme de code à sens unique. gig.log n\'envoie le mot lui-même qu\'après que d\'autres livreurs l\'ont confirmé.</string>
    <string name="census_review_screen_deleted">Supprimé. gig.log n\'a envoyé aucune vérification de cet écran.</string>
    <string name="census_review_screen_words_lost">gig.log a redémarré depuis qu\'il a vu cet écran, ses mots ne sont donc plus sur ce téléphone. Vous pouvez encore étiqueter des champs.</string>
    <string name="census_review_screen_release_unavailable">Le serveur du recensement n\'a pas encore préparé la vérification des mots d\'aujourd\'hui. Réessayez dans une heure ; vous pouvez encore étiqueter des champs.</string>
    <string name="census_review_screen_unreachable">gig.log n\'a pas pu joindre le serveur du recensement, donc aucun mot ne peut être vérifié.</string>
    <string name="census_review_screen_later">Le serveur du recensement est en pause ou ce téléphone a utilisé ses vérifications du jour. La vérification attend ; réessayez plus tard.</string>
    <string name="census_review_screen_send_unreachable">gig.log n\'a pas pu joindre le serveur du recensement. La vérification attend ; réessayez plus tard.</string>

