<?xml version="1.0" encoding="utf-8"?>
<!-- #583: Decline button background — muted surface so Accept is the emphasized action. Colour
     resources (values / values-night, #1445) resolve in the notification process; theme attrs do not. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/notif_decline_bg" />
    <corners android:radius="10dp" />
    <stroke android:width="1dp" android:color="@color/notif_decline_stroke" />
</shape>
