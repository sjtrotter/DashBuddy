<?xml version="1.0" encoding="utf-8"?>
<!-- #1333 S2g option B. RemoteViews widgets only; decorated style supplies side padding. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingTop="4dp" android:paddingBottom="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="28dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/notif_offer_store" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:textSize="18sp"
            android:ellipsize="end" android:maxLines="1" />
        <Chronometer android:id="@+id/notif_offer_countdown" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:id="@+id/notif_offer_left" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginStart="4dp" android:textSize="13sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp"
        android:layout_marginTop="10dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/notif_offer_hero" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1"
            android:includeFontPadding="false" android:textStyle="bold" />
        <ImageView android:id="@+id/notif_offer_gauge" android:layout_width="64dp" android:layout_height="64dp" />
    </LinearLayout>
    <ImageView android:id="@+id/notif_offer_bar" android:layout_width="match_parent"
        android:layout_height="34dp" android:layout_marginTop="12dp" android:scaleType="fitXY" />
    <LinearLayout android:id="@+id/notif_offer_rates" android:layout_width="match_parent"
        android:layout_height="24dp" android:layout_marginTop="12dp" android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView android:id="@+id/notif_offer_rate_0" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:gravity="start"
            android:maxLines="1" android:includeFontPadding="false" />
        <TextView android:id="@+id/notif_offer_rate_1" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center"
            android:maxLines="1" android:includeFontPadding="false" />
        <TextView android:id="@+id/notif_offer_rate_2" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end"
            android:maxLines="1" android:includeFontPadding="false" />
        <TextView android:id="@+id/notif_offer_addon" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="15sp" android:maxLines="1"
            android:visibility="gone" android:includeFontPadding="false" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:layoutDirection="ltr"
        android:layout_marginTop="14dp">

        <!-- #1254: Accept LEFT, Decline RIGHT — both platforms' native decline is a right-side
             target (DoorDash top-right, Uber card top-right X); our banner floats over DoorDash's. -->
        <TextView
            android:id="@+id/notif_btn_accept"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/notif_btn_accept"
            android:gravity="center"
            android:text="Accept"
            android:textColor="#0B0F14"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_btn_decline"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="24dp"
            android:background="@drawable/notif_btn_decline"
            android:gravity="center"
            android:text="Decline"
            android:textColor="#E6EDF3"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
