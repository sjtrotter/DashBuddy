<?xml version="1.0" encoding="utf-8"?>
<!-- #1333 S2g option B. RemoteViews widgets only; decorated style supplies side padding. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingTop="2dp" android:paddingBottom="2dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/notif_offer_hero" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginStart="10dp"
            android:maxLines="1" android:includeFontPadding="false" android:textStyle="bold" />
        <TextView android:id="@+id/notif_offer_profit" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginStart="10dp"
            android:maxLines="1" android:includeFontPadding="false" />
        <TextView android:id="@+id/notif_offer_note" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginStart="8dp"
            android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <Chronometer android:id="@+id/notif_offer_countdown" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="18sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:layoutDirection="ltr"
        android:layout_marginTop="6dp">

        <!-- #1254: Accept LEFT, Decline RIGHT — both platforms' native decline is a right-side
             target (DoorDash top-right, Uber card top-right X); our banner floats over DoorDash's. -->
        <TextView
            android:id="@+id/notif_btn_accept"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/notif_btn_accept"
            android:gravity="center"
            android:text="Accept"
            android:textColor="#0B0F14"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_btn_decline"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="24dp"
            android:background="@drawable/notif_btn_decline"
            android:gravity="center"
            android:text="Decline"
            android:textColor="#E6EDF3"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
