<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/census_credentials.preferences_pb" />
        <exclude domain="file" path="datastore/census_health.preferences_pb" />
        <exclude domain="file" path="census/" />
        <!-- #1202: plaintext debug UNKNOWN envelopes must not ride a backup or a device transfer. -->
        <exclude domain="external" path="captures/" />
        <exclude domain="file" path="captures/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/census_credentials.preferences_pb" />
        <exclude domain="file" path="datastore/census_health.preferences_pb" />
        <exclude domain="file" path="census/" />
        <!-- #1202: plaintext debug UNKNOWN envelopes must not ride a backup or a device transfer. -->
        <exclude domain="external" path="captures/" />
        <exclude domain="file" path="captures/" />
    </device-transfer>
</data-extraction-rules>
