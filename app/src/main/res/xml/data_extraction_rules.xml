<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/census_credentials.preferences_pb" />
        <exclude domain="file" path="datastore/census_health.preferences_pb" />
    <!-- #1189 (Astra review of PR #1252): the developer settings store carries the census upload/share toggles and the server's policy cache (incl. acceptedSchemaIds) — a restored phone must re-enrol and re-fetch policy, and re-decide the debug toggles, never inherit them. -->
    <exclude domain="file" path="datastore/dev_settings.preferences_pb" />
        <exclude domain="file" path="census/" />
        <!-- #1202: plaintext debug UNKNOWN envelopes must not ride a backup or a device transfer. -->
        <exclude domain="external" path="captures/" />
        <exclude domain="file" path="captures/" />
        <!-- #1236: re-consent on a new device; the database and app/economy preferences follow the user. -->
        <exclude domain="file" path="datastore/rule_capability_grants.preferences_pb" />
        <exclude domain="file" path="datastore/consent_event_receipt.preferences_pb" />
        <!-- #1214/#1236: debug logs, including the internal-storage fallback, are device-local. -->
        <exclude domain="external" path="app.log" />
        <exclude domain="external" path="shareable.log" />
        <exclude domain="external" path="shareable.log.1" />
        <exclude domain="external" path="logs/" />
        <exclude domain="file" path="app.log" />
        <exclude domain="file" path="shareable.log" />
        <exclude domain="file" path="shareable.log.1" />
        <exclude domain="file" path="logs/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/census_credentials.preferences_pb" />
        <exclude domain="file" path="datastore/census_health.preferences_pb" />
    <!-- #1189 (Astra review of PR #1252): the developer settings store carries the census upload/share toggles and the server's policy cache (incl. acceptedSchemaIds) — a restored phone must re-enrol and re-fetch policy, and re-decide the debug toggles, never inherit them. -->
    <exclude domain="file" path="datastore/dev_settings.preferences_pb" />
        <exclude domain="file" path="census/" />
        <!-- #1202: plaintext debug UNKNOWN envelopes must not ride a backup or a device transfer. -->
        <exclude domain="external" path="captures/" />
        <exclude domain="file" path="captures/" />
        <!-- #1236: re-consent on a new device; the database and app/economy preferences follow the user. -->
        <exclude domain="file" path="datastore/rule_capability_grants.preferences_pb" />
        <exclude domain="file" path="datastore/consent_event_receipt.preferences_pb" />
        <!-- #1214/#1236: debug logs, including the internal-storage fallback, are device-local. -->
        <exclude domain="external" path="app.log" />
        <exclude domain="external" path="shareable.log" />
        <exclude domain="external" path="shareable.log.1" />
        <exclude domain="external" path="logs/" />
        <exclude domain="file" path="app.log" />
        <exclude domain="file" path="shareable.log" />
        <exclude domain="file" path="shareable.log.1" />
        <exclude domain="file" path="logs/" />
    </device-transfer>
</data-extraction-rules>
