    <!-- copy-audit: retranslated es -->
    <string name="app_notice_channel_description">Avisos cuando gig.log no puede leer ni decir las ofertas</string>
    <string name="locale_notice_title">gig.log solo lee pantallas en inglés</string>
    <!-- copy-audit: retranslated es -->
    <string name="locale_notice_text">Tu teléfono no está en inglés. gig.log solo lee las aplicaciones de reparto en inglés, así que puede omitir la mayoría de las ofertas y entregas, y sus filtros de privacidad pueden omitir datos de clientes. Cambiar el teléfono a inglés corrige ambas cosas, aunque ningún filtro lo detecta todo.</string>

