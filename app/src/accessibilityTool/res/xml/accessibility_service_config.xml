<!-- #1414: the debug and sideload builds' copy. It declares isAccessibilityTool="true" because Android 14+
     delivers events an app marks accessibility-data-sensitive (Uber's offer pop-up) only to a service that
     declares it. The Play build uses app/src/main/res/xml/accessibility_service_config.xml, identical except
     that it says false. Keep the two files in step; AccessibilityToolFlagGuardTest fails when they differ in
     anything but the flag. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:isAccessibilityTool="true"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewClicked|typeWindowsChanged"
    android:packageNames="com.doordash.driverapp,com.ubercab.driver,com.instacart.shopper,com.walmart.spark"
    android:accessibilityFeedbackType="feedbackSpoken"
    android:notificationTimeout="100"
    android:canTakeScreenshot="true"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows|flagIncludeNotImportantViews" />
